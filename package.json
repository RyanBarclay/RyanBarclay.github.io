{
  "name": "ryanbarclay-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "tsc": "turbo run tsc",
    "preview": "turbo run preview --filter=frontend",
    "deploy": "turbo run build --filter=frontend && cp apps/frontend/CNAME apps/frontend/dist/ && gh-pages -d apps/frontend/dist"
  },
  "devDependencies": {
    "gh-pages": "^5.0.0",
    "turbo": "^2.5.8"
  }
}
