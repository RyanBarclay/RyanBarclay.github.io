# Frontend environment variables — COMMITTED ON PURPOSE.
#
# RULE: anything with the VITE_ prefix is inlined into the public JS
# bundle at build time and shipped to every browser. Only ever put
# PUBLIC values here. Secrets (private API keys, service credentials)
# do not belong in this file, with or without the prefix — backend
# secrets live in GCP Secret Manager (see docs/backend-plan.md).

# PostHog project API key (phc_…): a write-only ingest key, public by
# design — it can capture events and read feature flags, nothing else.
VITE_POSTHOG_PROJECT_TOKEN=phc_iClikXjpcKQsn4UfBioSZFSA4z9dOU2oP8og1mKqKai
VITE_POSTHOG_HOST=https://us.i.posthog.com
